# Which LLM provider to use for idea/script/metadata generation.
# "gemini" and "groq" are free-tier; "anthropic" is paid.
LLM_PROVIDER=gemini

# Google Gemini (free tier) -- get a key at https://ai.google.dev
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (free tier) -- get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (paid) -- only used if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Pexels (free stock video footage) -- get a key at https://www.pexels.com/api/
PEXELS_API_KEY=

# YouTube Data API v3 OAuth client (download from Google Cloud Console,
# save as credentials/client_secret.json instead of pasting it here)
YOUTUBE_CLIENT_SECRET_FILE=credentials/client_secret.json
YOUTUBE_TOKEN_FILE=credentials/token.json

# Channel / content defaults
CHANNEL_NAME=rgraphiiee
CHANNEL_NICHE=faceless narration: facts, stories, and top-10 lists
VIDEO_LANGUAGE=en
TTS_VOICE=en-US-GuyNeural
VIDEO_RESOLUTION=1920x1080
DEFAULT_PRIVACY_STATUS=private
